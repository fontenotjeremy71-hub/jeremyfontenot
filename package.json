{
  "name": "jeremyfontenot-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Static portfolio build and validation tooling.",
  "scripts": {
    "build:evidence": "node scripts/build/generate-evidence-pages.js",
    "check:evidence": "node scripts/build/generate-evidence-pages.js --check",
    "build:dashboard": "node scripts/build/generate-dashboard-data.js",
    "check:dashboard": "node scripts/build/generate-dashboard-data.js --check",
    "build:foundation": "node scripts/build/generate-site-foundation.js",
    "check:foundation": "node scripts/build/generate-site-foundation.js --check",
    "validate:foundation": "node scripts/validation/validate-site-foundation.js",
    "check:readiness": "node scripts/validation/validate-job-readiness.js",
    "check:publication": "npm run build:foundation && node scripts/build/prepare-public-site.js --check",
    "build:site": "npm run build:foundation && node scripts/build/prepare-public-site.js",
    "build": "npm run build:evidence && npm run build:dashboard && npm run build:foundation",
    "check": "npm run build:foundation && npm run check:evidence && npm run check:dashboard && npm run check:readiness && npm run check:foundation && npm run validate:foundation && npm run check:publication",
    "serve:test": "node scripts/testing/serve-static-site.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "markdown-it": "14.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "playwright": "1.60.0"
  }
}
